{
  "entities": {
    "Channel": {
      "title": "Broadcast Channel",
      "description": "A live television or visual radio channel available on Kakumiro Online TV.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": ["Television", "Radios"]
        },
        "subtitle": {
          "type": "string",
          "maxLength": 120
        },
        "brand": {
          "type": "string",
          "enum": ["default", "nbs", "citizen", "sanyuka", "sport", "radio"]
        },
        "progress": {
          "type": "number"
        },
        "program": {
          "type": "string",
          "maxLength": 140
        },
        "streamUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "streamType": {
          "type": "string",
          "enum": ["auto", "hls", "media", "audio", "embed"]
        },
        "useRelayServer": {
          "type": "boolean"
        },
        "iconUrl": {
          "type": "string",
          "maxLength": 200000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "type", "subtitle", "brand", "progress", "program"]
    },
