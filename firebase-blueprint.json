      "description": "Written breaking news articles and reports managed by station administrators."
    },
    "/artists/{artistId}": {
      "schema": { "$ref": "#/entities/Artist" },
      "description": "Musician and performing artist profiles managed by station administrators."
    },
    "/stationUpdates/{updateId}": {
      "schema": { "$ref": "#/entities/StationUpdate" },
      "description": "Real-time update feed entries across admin control panel, news, channels, radios, artists, podcasts, and media."
    },
    "/fcmSubscriptions/{subId}": {
      "schema": { "$ref": "#/entities/FcmSubscription" },
