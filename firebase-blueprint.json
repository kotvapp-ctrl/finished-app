      "schema": { "$ref": "#/entities/Movie" },
      "description": "Movies and series catalog."
    },
    "/archiveItems/{itemId}": {
      "schema": { "$ref": "#/entities/ArchiveItem" },
      "description": "Catch-up TV archive and podcast episodes."
    },
    "/settings/promo": {
      "schema": { "$ref": "#/entities/PromoSettings" },
      "description": "Home Hero Promo configuration document."
    },
    "/settings/appConfig": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global application settings and feature flags."
    },
    "/settings/homeConfig": {
      "schema": { "$ref": "#/entities/HomeSettings" },
      "description": "Admin-controlled Home screen layout, visibility, headings, and channel ordering."
    },
